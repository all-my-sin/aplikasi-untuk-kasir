# --- Database -------------------------------------------------------------
# Matches docker-compose.yml (host port 5433). Change for your own server.
DATABASE_URL="postgresql://pos:pos_dev_password@localhost:5433/pos?schema=public"
# Separate database used by the automated test-suite (it is wiped by tests!)
TEST_DATABASE_URL="postgresql://pos:pos_dev_password@localhost:5433/pos_test?schema=public"

# --- Auth -----------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Session lifetime (jsonwebtoken format, e.g. 12h, 1d)
JWT_EXPIRES_IN="12h"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (dev frontend runs on 5173)
CORS_ORIGIN="http://localhost:5173"
# Set to true when serving over HTTPS so the session cookie is marked Secure.
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Directory where uploaded product images / logos are stored
UPLOAD_DIR="uploads"
